# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/the_system
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Google OAuth (keep the real client secret private)
APP_SECURITY_GOOGLE_ENABLED=true
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=your-google-client-id
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=your-google-client-secret
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_SCOPE=openid,profile,email
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_REDIRECT_URI=http://localhost:5173/login/oauth2/code/google

# Application URLs
APP_FRONTEND_URL=http://localhost:5173
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional email configuration
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@the-system.local

# Set true when serving over HTTPS
SESSION_COOKIE_SECURE=false
